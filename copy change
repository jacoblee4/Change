(function executeRule(current, previous) {
	var key = 'ci_item'; // use 'cmdb_ci_service' on task_cmdb_ci_service

	var chg = new GlideRecord('change_request');
	if (!chg.get(current.getValue('task')) || !chg.getValue('copied_from'))
		return;

	var src = new GlideRecord(current.getTableName());
	src.addQuery('task', chg.getValue('copied_from'));
	src.addQuery(key, current.getValue(key));
	src.addQuery('u_form_recommendation', true);
	src.setLimit(1);
	src.query();

	if (src.hasNext())
		current.setAbortAction(true);
})(current, previous);
