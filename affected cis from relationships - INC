var upstream = JSON.parse(gs.getProperty('incident_downstream_affected_ci', "{}"));
var downstream = JSON.parse(gs.getProperty('incident_upstream_affected_ci', "{}"));
var sys_id = current.sys_id || current.setNewGuid();

if(!current.isNewRecord() && current.cmdb_ci != previous.cmdb_ci){
	removeCiRelationsToAffectedCi(null, previous.cmdb_ci, null, null);
}

if(current.cmdb_ci != previous.cmdb_ci){
	addCiRelationsToAffectedCi(null, current.cmdb_ci, null, null);
}

function removeCiRelationsToAffectedCi(ci_rel, ci, parent, dir){

	if(!ci && parent){
		ci = ci_rel.child;
	}else if(!ci){
		ci = ci_rel.parent;
	}

	if(ci){
		var previous_up = getImpactedRelations(getRelationFromCi(ci, true), ci, true);
		var previous_down = getImpactedRelations(getRelationFromCi(ci, false), ci, false);

		if(previous_up && (!dir || dir == "up") && upstream.execute){
			while(previous_up.next()){

				if(upstream.recursive)
					removeCiRelationsToAffectedCi(previous_up, null, true, "up");

				removeFromAffectedCi(previous_up, true);

			}
		}

		if(previous_down && (!dir || dir == "down") && downstream.execute){
			while(previous_down.next()){

				if(downstream.recursive)
					removeCiRelationsToAffectedCi(previous_down, null, false, "down");

				removeFromAffectedCi(previous_down, false);
			}
		}
	}
}

function addCiRelationsToAffectedCi(ci_rel, ci, parent, dir){
	
	if(!ci && parent){
		ci = ci_rel.child;
	}else if(!ci){
		ci = ci_rel.parent;
	}

	if(ci){
		var up = getImpactedRelations(getRelationFromCi(ci, true), ci, true);
		var down = getImpactedRelations(getRelationFromCi(ci, false), ci, false);

		if(up && (!dir || dir == "up") && upstream.execute){
			while(up.next()){

				if(upstream.recursive)
					addCiRelationsToAffectedCi(up, null, true, "up");

				addToAffectedCi(up, true);
			}
		}

		if(down && (!dir || dir == "down") && downstream.execute ){
			while(down.next()){
				if(downstream.recursive)
					addCiRelationsToAffectedCi(down, null, false, "down");

				addToAffectedCi(down, false);
			}
		}

	}
}


function removeFromAffectedCi(ci_rel, parent){
	var ci = '';

	if(parent){
		ci = ci_rel.child;
	}else{
		ci = ci_rel.parent;
	}

	var ci_class = ci.sys_class_name || ci.getTableName();
	var link_table = 'task_ci';
	var link_name = 'ci_item';

	if(ci_class == 'cmdb_ci_service'){
		link_table = 'task_cmdb_ci_service';
		link_name = 'cmdb_ci_service';
	}

	var affected_cis = new GlideRecord(link_table);
	affected_cis.addQuery('task', sys_id);
	affected_cis.addQuery(link_name, ci);
	affected_cis.query();

	affected_cis.deleteMultiple();
}

function addToAffectedCi(ci_rel, parent){
	var ci = '';

	if(parent){
		ci = ci_rel.child;
	}else{
		ci = ci_rel.parent;
	}

	var ci_class = ci.sys_class_name || ci.getTableName();
	var link_table = 'task_ci';
	var link_name = 'ci_item';

	if(ci_class == 'cmdb_ci_service'){
		link_table = 'task_cmdb_ci_service';
		link_name = 'cmdb_ci_service';
	}

	var affected_cis = new GlideRecord(link_table);
	affected_cis.addQuery('task', sys_id);
	affected_cis.addQuery(link_name, ci);
	affected_cis.query();

	if(affected_cis.getRowCount() == 0){
		affected_cis.initialize();
		affected_cis.setValue('task', sys_id);
		affected_cis.setValue(link_name, ci);
		affected_cis.insert();
	}

}

function getImpactedRelations(rels, ci, parent){
	
	var realRelations = new GlideRecord('cmdb_rel_ci');
	var queries = [];
	if(rels.length != 0){
		rels.forEach(function(rel) {
			var conditions = [];

			if(parent){
				conditions.push("parent=" + ci.sys_id);
			}else{
				conditions.push("child=" + ci.sys_id);
			}

			conditions.push("parent.sys_class_nameINSTANCEOF" + rel.base_class);
			conditions.push("child.sys_class_nameINSTANCEOF" + rel.dependent_class);
			conditions.push("type=" + rel.relationship.split(':')[1]);
			queries.push(conditions.join('^'));
		});

		realRelations.addEncodedQuery(queries.join('^NQ'));
		realRelations.query();

		return realRelations;
	}
}

function getRelationFromCi(ci, parent){
	var table_name = (ci.sys_class_name || ci.getTableName());
	var table = new TableUtils(table_name);
	var parents_tables = JSON.parse(JSON.stringify(table.getTables().toArray())).join(',');

	var impacted_relations = new GlideRecord('cmdb_rel_type_suggest');
	impacted_relations.addQuery('u_impacted_relation', 1);

	if(parent){
		impacted_relations.addQuery('base_class', "IN", parents_tables);
		impacted_relations.addQuery('', "STARTWITH", 'parent:');
	}else{
		impacted_relations.addQuery('dependent_class', "IN", parents_tables);
		impacted_relations.addQuery('', "STARTWITH", 'child:');
	}

	impacted_relations.query();
	var relations = [];

	while(impacted_relations.next()){
		var obj = {
			base_class : impacted_relations.getValue('base_class'),
			relationship : impacted_relations.getValue('relationship'),
			dependent_class : impacted_relations.getValue('dependent_class'),
		};
		relations.push(obj);
	}

	return relations;
}
