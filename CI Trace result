(function executeRule(current, previous /* null when async */) {

    var taskSysId = current.getValue('task');

    if (!taskSysId)
        return;

    // Get the parent task record.
    var taskGR = current.task.getRefRecord();

    if (!taskGR || !taskGR.isValidRecord())
        return;

    var taskTable = taskGR.getRecordClassName();

    // Only run for Incidents and Changes.
    if (taskTable !== 'incident' && taskTable !== 'change_request')
        return;

    rebuildRelatedAffectedCIs(taskTable, taskSysId);


    function rebuildRelatedAffectedCIs(parentTable, parentSysId) {

        var ciIds = [];
        var seen = {};

        // Query all affected CI records for this task.
        var taskCiGR = new GlideRecord('task_ci');
        taskCiGR.addQuery('task', parentSysId);
        taskCiGR.addNotNullQuery('ci_item');
        taskCiGR.query();

        while (taskCiGR.next()) {
            var ciId = taskCiGR.getValue('ci_item');

            if (ciId && !seen[ciId]) {
                seen[ciId] = true;
                ciIds.push(ciId);
            }
        }

        // Get the parent Incident or Change.
        var parentGR = new GlideRecord(parentTable);

        if (!parentGR.get(parentSysId))
            return;

        var newValue = ciIds.join(',');
        var existingValue = parentGR.getValue('u_related_affected_cis') || '';

        // Avoid unnecessary updates.
        if (existingValue === newValue)
            return;

        parentGR.setValue('u_related_affected_cis', newValue);

        parentGR.update();
    }

})(current, previous);
